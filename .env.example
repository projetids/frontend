# Copier en .env : cp .env.example .env
#
# TOUTE variable VITE_ est publiée dans le bundle livré au navigateur :
# n'y mets jamais de secret (clé API privée, mot de passe, token).
# Le backend, lui, lit backend/.env côté serveur uniquement.

# Base URL de l'API, telle que le NAVIGATEUR doit l'atteindre.
# En dev sur l'hôte : http://localhost:3000/api/v1
# Frontend conteneurisé : garder localhost:3000, c'est le port PUBLIÉ par compose
# sur la machine hôte ; http://backend:3000 ne marcherait pas (résolution uniquement
# à l'intérieur du réseau Docker, et le navigateur n'y est pas).
VITE_API_URL=http://localhost:3000/api/v1

# Ce fichier n'est pas copié dans l'image de production (.dockerignore) : pour un build
# d'image, passer la valeur en argument :
#   docker build --build-arg VITE_API_URL=https://api.exemple.mg/api/v1 --target runner -t ids-frontend .

# Port hôte publié par docker-compose.yml (même dossier). Utile si 5173 est déjà pris.
# Sans préfixe VITE_ : lu par compose seul, jamais inliné dans le bundle.
DEV_PORT=5173
